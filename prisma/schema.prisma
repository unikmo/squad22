generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Pharmacy {
  id       String  @id
  npi      String  @unique
  name     String
  address1 String
  address2 String?
  city     String
  state    String
  zip      String
  phone    String

  profileStatus       String  @default("unclaimed") // MVP mapping from existing UI
  pricingPublished    Boolean @default(false)
  reservationsEnabled Boolean @default(false)

  // --- Phase 3 (lean onboarding) enrichment ---
  website                String? // nullable
  email                  String? // nullable
  preferredContactMethod String? // nullable

  outreachStatus     String    @default("not_started")
  outreachLastSentAt DateTime?
  outreachAttempts   Int       @default(0)

  enrichmentStatus String  @default("missing")
  enrichmentSource String?

  // --- Phase 4 (onboarding engine scaffolding) ---
  // Local delivery support (max 20 miles treated as hard cap by API/UI/smoke)
  deliveryEnabled            Boolean @default(false)
  deliveryRadiusMiles        Int?
  deliveryFeeCents           Int?
  deliveryMinimumOrderCents  Int?
  freeDeliveryThresholdCents Int?

  // Founding pharmacy program
  foundingPartner Boolean @default(false)
  freeTrialMonths Int     @default(6)
  rewardsEnabled  Boolean @default(true)

  assistanceSupportEnabled   Boolean @default(false)
  manufacturerAssistanceHelp Boolean @default(false)
  foundationAssistanceHelp   Boolean @default(false)
  publicProgramHelp          Boolean @default(false)
  localAssistanceHelp        Boolean @default(false)
  assistanceContactName      String?
  assistanceContactPhone     String?
  assistanceContactEmail     String?
  assistanceNotes            String?

  // Relations
  pharmacyClaims     PharmacyClaim[]
  reservations       Reservation[]
  drugPrices         DrugPrice[]
  claimInvites       ClaimInvite[]
  rewardTransactions RewardTransaction[]
  members            PharmacyMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state])
  @@index([outreachStatus])
}

model ClaimInvite {
  id    String @id @default(cuid())
  token String @unique

  pharmacyNpi String
  pharmacy    Pharmacy @relation(fields: [pharmacyNpi], references: [npi])

  status String @default("active") // active | used | revoked

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime?

  usedClaimId String?
  metadata    Json? // optional batch metadata

  @@index([pharmacyNpi])
  @@index([status])
  @@index([createdAt])
}

model PharmacyClaim {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacyNpi String
  pharmacy    Pharmacy @relation(fields: [pharmacyNpi], references: [npi])

  status String @default("unclaimed") // MVP: store request status

  // Store submitted payload for MVP auditing
  submittedPayload Json

  @@index([pharmacyNpi])
}

model Reservation {
  id                String   @id
  reservationNumber String   @unique
  createdAt         DateTime @default(now())

  status String @default("pending")

  // Reservation fee policy preparation for future activation.
  // Defaults today to a refundable deposit, but no payment is charged.
  reservationFeeCents   Int       @default(500)
  reservationFeeStatus  String    @default("waived")
  stripePaymentIntentId String?   @unique
  stripePaymentStatus   String?
  stripeAuthorizedAt    DateTime?
  stripeCapturedAt      DateTime?
  stripeCanceledAt      DateTime?
  noShowEligibleAt      DateTime?
  paymentFailureReason  String?

  // --- Phase 4 fulfillment + rewards scaffolding ---
  fulfillmentMethod String @default("pickup") // pickup | local_delivery
  deliveryAddress   Json?
  deliveryFeeCents  Int?

  rewardRateBps         Int                 @default(100) // 100 bps = 1%
  rewardPointsEstimated Int                 @default(0)
  rewardStatus          String              @default("pending")
  actualPurchaseCents   Int?
  completedAt           DateTime?
  patientId             String?
  patient               User?               @relation(fields: [patientId], references: [id])
  pointsRedeemed        Int                 @default(0)
  rewardDiscountCents   Int                 @default(0)
  assistanceRequested   Boolean             @default(false)
  rewardTransactions    RewardTransaction[]

  prescriptionStatus String @default("unknown") // unknown | not_required | required_pending_verification | on_file

  // Denormalized FK to simplify MVP
  pharmacyNpi String
  pharmacy    Pharmacy @relation(fields: [pharmacyNpi], references: [npi])

  // Store submitted payload
  reservationInput Json
  priceResult      Json
}

model User {
  id                  String              @id @default(cuid())
  name                String?
  email               String?             @unique
  emailVerified       DateTime?
  image               String?
  accounts            Account[]
  sessions            Session[]
  reservations        Reservation[]
  rewardTransactions  RewardTransaction[]
  pharmacyMemberships PharmacyMember[]
  role                String              @default("PATIENT") // PATIENT | ADMIN
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model PharmacyMember {
  id          String   @id @default(cuid())
  pharmacyNpi String
  pharmacy    Pharmacy @relation(fields: [pharmacyNpi], references: [npi], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email       String
  role        String   @default("OWNER") // OWNER | MANAGER | STAFF
  status      String   @default("active") // invited | active | revoked
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([pharmacyNpi, email])
  @@index([userId])
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model RewardTransaction {
  id                 String       @id @default(cuid())
  userId             String
  user               User         @relation(fields: [userId], references: [id])
  pharmacyNpi        String
  pharmacy           Pharmacy     @relation(fields: [pharmacyNpi], references: [npi])
  reservationId      String?
  reservation        Reservation? @relation(fields: [reservationId], references: [id])
  type               String // earned | redeemed | reversed
  points             Int // signed ledger amount
  eligibleSpendCents Int?
  fundingCents       Int?
  description        String?
  createdAt          DateTime     @default(now())

  @@unique([reservationId, type])
  @@index([userId, createdAt])
  @@index([pharmacyNpi, createdAt])
}

model ReservationCounter {
  id         String   @id // YYYYMMDD
  yyMMdd     String   @unique
  nextNumber Int      @default(1)
  updatedAt  DateTime @updatedAt
}

model DrugPrice {
  id             String  @id
  pharmacyId     String
  pharmacyNpi    String
  drugName       String
  strength       String
  quantity       Int
  cashPriceCents Int
  ndc            String?

  // Phase 4: product type supports prescription vs OTC reservation flows.
  productType   String   @default("prescription") // prescription | otc
  source        String   @default("manual")
  status        String   @default("active")
  effectiveDate DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pharmacy Pharmacy @relation(fields: [pharmacyNpi], references: [npi])

  // Convenience relation: Pharmacy has many DrugPrices.
  // DrugPrice belongs to a Pharmacy via pharmacyNpi.

  @@unique([pharmacyNpi, drugName, strength, quantity, status])
  @@index([pharmacyNpi])
  @@index([drugName])
  @@index([strength])
  @@index([quantity])
  @@index([status])
}

model DoctorReferral {
  id                           String @id
  doctorName                   String
  city                         String
  state                        String
  referralCode                 String @unique
  referralCount                Int    @default(0)
  estimatedPatientSavingsCents Int    @default(0)
  status                       String @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
